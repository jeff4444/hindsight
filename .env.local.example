# Copy to .env.local and fill in the service role key.
#
# The service role key bypasses row level security. Both `charts` and `rounds` have RLS
# enabled with no policies at all, so this key is the only way anything reads them — which is
# the point: `charts` holds the future price data that §12.1 says must never reach a client.
#
# Keep it server-side. It must never be prefixed NEXT_PUBLIC_, and it must never be imported
# into a client component. Find it under Project Settings > API Keys > service_role.

NEXT_PUBLIC_SUPABASE_URL=https://usqmfzuibwrjfcvcprhn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Publishable key (Project Settings -> API). NOT prefixed NEXT_PUBLIC_ on purpose.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
