# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but not the template. README tells you to copy it, and serviceClient()
# points at it by name when the key is missing.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hindsight
/.data/
/supabase/.temp/
/.corpus-cache/

# Nested worktrees Claude Code creates for isolated runs. 566 MB of build output one
# `git add -A` away from the index; launch.json is the only thing here worth tracking.
/.claude/*
!/.claude/launch.json
