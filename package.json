    "verify": "tsx --env-file-if-exists=.env.local scripts/verify-rounds.ts",
    "universe": "tsx scripts/universe.ts",
    "achievable": "tsx --env-file-if-exists=.env.local scripts/backfill-achievable.ts",
    "extend": "tsx --env-file-if-exists=.env.local scripts/extend-corpus.ts",
    "retire": "tsx --env-file-if-exists=.env.local scripts/retire.ts",
    "fairness": "tsx --env-file-if-exists=.env.local scripts/fairness.ts",
    "ladder": "tsx --env-file-if-exists=.env.local scripts/ladder.ts",
    "leak": "tsx --env-file-if-exists=.env.local scripts/round-number-leak.ts",
    "themes": "tsx --env-file-if-exists=.env.local scripts/themes.ts",
    "null": "tsx --env-file-if-exists=.env.local scripts/null.ts",
    "conditional": "tsx --env-file-if-exists=.env.local scripts/conditional.ts",
    "engines": "tsx --env-file-if-exists=.env.local scripts/engines.ts",
